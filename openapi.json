{
  "openapi": "3.1.0",
  "info": {
    "title": "SETU-DRR API",
    "description": "Hazard Red Zone Identification, Carrying Capacity Assessment & Relocation Decision Support Platform.",
    "version": "v1.0.0"
  },
  "paths": {
    "/health/live": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Process liveness check",
        "description": "Returns 200 OK if the FastAPI process is responsive.",
        "operationId": "check_liveness_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Check Liveness Health Live Get"
                }
              }
            }
          }
        }
      }
    },
    "/health/ready": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Application readiness check",
        "description": "Checks database connectivity, PostGIS & H3 extensions, and serving version.",
        "operationId": "check_readiness_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/zones": {
      "get": {
        "tags": [
          "Hazard Zones"
        ],
        "summary": "Query H3 hazard zones within spatial viewport",
        "description": "Retrieves active Multi-Hazard Index and dominant hazard classifications for H3 hexagonal grid cells within the specified bounding box.",
        "operationId": "get_zones_zones_get",
        "parameters": [
          {
            "name": "bbox",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Bounding box as 'min_lon,min_lat,max_lon,max_lat' (e.g. '75.8,11.5,76.3,11.9')",
              "title": "Bbox"
            },
            "description": "Bounding box as 'min_lon,min_lat,max_lon,max_lat' (e.g. '75.8,11.5,76.3,11.9')",
            "example": "75.8,11.5,76.3,11.9"
          },
          {
            "name": "res",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 9,
              "minimum": 6,
              "description": "H3 grid resolution (6=Overview, 7=National, 8=Pilot, 9=Site)",
              "default": 8,
              "title": "Res"
            },
            "description": "H3 grid resolution (6=Overview, 7=National, 8=Pilot, 9=Site)"
          },
          {
            "name": "valid_at",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Historical timestamp to evaluate (ISO 8601). Defaults to latest.",
              "title": "Valid At"
            },
            "description": "Historical timestamp to evaluate (ISO 8601). Defaults to latest."
          },
          {
            "name": "admin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Administrative Unit ID or LGD Code (e.g. 555 for Wayanad)",
              "title": "Admin"
            },
            "description": "Filter by Administrative Unit ID or LGD Code (e.g. 555 for Wayanad)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 5000,
              "minimum": 1,
              "description": "Maximum number of cells to return (max 5000).",
              "default": 1000,
              "title": "Limit"
            },
            "description": "Maximum number of cells to return (max 5000)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/ZoneCellSummary"
                  },
                  "title": "Response Get Zones Zones Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/zones/{h3}": {
      "get": {
        "tags": [
          "Hazard Zones"
        ],
        "summary": "Get full cell detail and SHAP/heuristic explanation",
        "description": "Retrieves multi-hazard breakdown, static/live MHI, and feature attributions for a single H3 cell.",
        "operationId": "get_zone_detail_zones__h3__get",
        "parameters": [
          {
            "name": "h3",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "description": "H3 index as hexadecimal string (e.g. '8860064989fffff')",
              "title": "H3"
            },
            "description": "H3 index as hexadecimal string (e.g. '8860064989fffff')",
            "example": "8860064989fffff"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ZoneCellDetail"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/habitations": {
      "get": {
        "tags": [
          "Habitations & Triage"
        ],
        "summary": "Get prioritized habitation triage queue",
        "description": "Returns a paginated list of habitations ranked by Per-Capita Urgency or Caseload. Supports filtering by Administrative Boundary (LGD Code) and 4-tier Triage Category.",
        "operationId": "get_habitations_habitations_get",
        "parameters": [
          {
            "name": "admin",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Administrative Unit ID or LGD Code (e.g. 555 for Wayanad)",
              "title": "Admin"
            },
            "description": "Filter by Administrative Unit ID or LGD Code (e.g. 555 for Wayanad)"
          },
          {
            "name": "tier",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/Tier"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by Triage Tier (Immediate, Short-term, Medium-term, Mitigate in situ)",
              "title": "Tier"
            },
            "description": "Filter by Triage Tier (Immediate, Short-term, Medium-term, Mitigate in situ)"
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/SortMode",
              "description": "Ranking mode: 'urgency' (PS_j) or 'caseload' (PS_j * population)",
              "default": "urgency"
            },
            "description": "Ranking mode: 'urgency' (PS_j) or 'caseload' (PS_j * population)"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 200,
              "minimum": 1,
              "description": "Number of records per page (max 200).",
              "default": 50,
              "title": "Limit"
            },
            "description": "Number of records per page (max 200)."
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Pagination offset.",
              "default": 0,
              "title": "Offset"
            },
            "description": "Pagination offset."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_HabitationListItem_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/habitations/{id}/risk": {
      "get": {
        "tags": [
          "Habitations & Triage"
        ],
        "summary": "Get complete risk dossier for a habitation",
        "description": "Retrieves vulnerability breakdown (SoVI), time-decayed loss history, and priority score explanation.",
        "operationId": "get_habitation_risk_dossier_habitations__id__risk_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "description": "Habitation ID (integer primary key).",
              "title": "Id"
            },
            "description": "Habitation ID (integer primary key).",
            "example": 1
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HabitationRiskDossier"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/": {
      "get": {
        "tags": [
          "General"
        ],
        "summary": "Root Info",
        "description": "Root metadata endpoint.",
        "operationId": "root_info__get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Root Info  Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "FeatureContributionDTO": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature",
            "description": "Feature name, e.g. slope_deg, hand_m, dist_to_road_m."
          },
          "value": {
            "type": "number",
            "title": "Value",
            "description": "Observed feature value."
          },
          "contribution": {
            "type": "number",
            "title": "Contribution",
            "description": "SHAP attribution or heuristic weight."
          },
          "method": {
            "type": "string",
            "title": "Method",
            "description": "Explanation calculation method (e.g. 'heuristic', 'treeshap').",
            "default": "heuristic"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "value",
          "contribution"
        ],
        "title": "FeatureContributionDTO"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
